# InkPreview environment contract.
# Copy to .env and fill in. NEVER commit a real .env (it is git-ignored).
#
# Local dev needs NONE of these — the defaults in app/config.py boot with
# SQLite + in-process jobs + filesystem storage + the mock image engine.
# These values are for the Docker / VPS deploy (and for enabling real OpenAI).

# --- App ---
APP_ENV=prod
DEBUG=false
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=https://your-domain.tld

# --- Database (Postgres in prod) ---
POSTGRES_USER=inkpreview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inkpreview
# DATABASE_URL is set by docker-compose from the POSTGRES_* vars above.
# For non-compose deploys, set it explicitly:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/inkpreview

# --- Queue (Redis + Arq in prod) ---
JOB_MODE=arq
REDIS_URL=redis://redis:6379

# --- Storage (S3 / MinIO in prod) ---
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET=inkpreview
# Public base URL where stored media is served (CDN/object-store public host).
MEDIA_BASE_URL=https://media.your-domain.tld

# --- Image engine (OpenAI) ---
IMAGE_ENGINE=openai
OPENAI_API_KEY=sk-...your-key...
# Both steps use gpt-image-2 (best quality). It has no transparent-bg support,
# so generation runs opaque + automatic background removal. Set the generate
# model to gpt-image-1 if you prefer native transparency (e.g. for color art).
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_COMPOSITE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Body-preview composite quality. The 3-image occlusion + skin-wrap edit needs
# more fidelity than generation — at "low" the fine linework under-inks (faint).
# Keep >= medium even if OPENAI_IMAGE_QUALITY is set to low for fast generation.
OPENAI_COMPOSITE_QUALITY=medium
OPENAI_TEXT_MODEL=gpt-4o-mini
JOB_MODE=arq

# --- Limits / privacy ---
ANON_RATE_LIMIT=30
RATE_LIMIT_WINDOW_S=3600
BODY_PHOTO_TTL_HOURS=24
PREVIEW_TTL_HOURS=24
MAX_UPLOAD_MB=12
FREE_EXPORT_MAX_PX=1024

# --- Frontend build ---
PUBLIC_API_BASE=https://your-domain.tld
